# Postgres connection string (Railway provides this automatically when you
# add a Postgres plugin to your project)
DATABASE_URL="postgresql://user:password@localhost:5432/strength_app"

# Claude API key, used by src/services/workoutPlanner.ts
ANTHROPIC_API_KEY="sk-ant-..."

# Long random string used to sign session tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Outlook calendar sync (optional — the app works fine without this, it
# just won't create/update calendar events for logged sessions). See the
# "Outlook calendar sync" section in the README for how to get these from
# the Azure portal.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_REDIRECT_URI="http://localhost:3001/integrations/outlook/callback"

# Strava sync (optional — lets you link a real Strava activity's duration
# as a session's actual time, instead of only typing it in by hand). See
# the "Strava sync" section in the README for how to get these from
# Strava's API settings page.
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
STRAVA_REDIRECT_URI="http://localhost:3001/integrations/strava/callback"

# Where the backend redirects back to after the Outlook OAuth flow
# completes. Set this to your deployed frontend URL in production.
FRONTEND_URL="http://localhost:5173"

# Fallback location for the Calendar tab's 10-day weather forecast, only
# used if the device denies/lacks location access — the app normally asks
# the browser for the user's actual location instead. Decimal degrees, e.g.:
# LOCATION_LAT="51.1428"
# LOCATION_LON="-0.4808"
LOCATION_LAT=""
LOCATION_LON=""

PORT=3001
